{
	"name": "@brief/category-worker",
	"type": "module",
	"scripts": {
		"dev": "tsx watch --clear-screen=false src/index.ts",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"typecheck": "tsc --noEmit",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"test": "vitest run",
		"job:run": "tsx src/scripts/runCategoryJob.ts",
		"llm:ping": "tsx src/scripts/pingLlm.ts",
		"llm:fixture": "tsx src/scripts/buildLlmFixture.ts",
		"llm:reference": "tsx src/scripts/llmBench.ts reference",
		"llm:test-tools": "tsx src/scripts/llmBench.ts tools",
		"llm:test-selection": "tsx src/scripts/llmBench.ts selection",
		"llm:test-summary": "tsx src/scripts/llmBench.ts summary",
		"llm:benchmark": "tsx src/scripts/llmBench.ts benchmark",
		"llm:report": "tsx src/scripts/llmBench.ts report"
	},
	"dependencies": {
		"@brief/common": "workspace:*",
		"@brief/drizzle": "workspace:*",
		"@brief/infra": "workspace:*",
		"@brief/services": "workspace:*",
		"@tanstack/ai": "^0.42.0",
		"amqplib": "catalog:",
		"zod": "catalog:"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}

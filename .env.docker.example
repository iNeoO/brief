# Production environment for docker-compose.prod.yaml. Copy to `.env.docker`.
# Compose reads it both as the source of the ${...} it interpolates and as the
# env_file the containers receive, so hostnames are container names.

# --- Postgres (this stack) -------------------------------------------------
PG_DB=brief
PG_USER=brief
PG_PASSWORD=
PG_HOST_PORT=5434
PG_URL=postgresql://brief:CHANGE_ME@postgres:5432/brief

# --- Shared services -------------------------------------------------------
# Redis, RabbitMQ and Garage run outside this stack; it joins their networks
# and addresses them by container name. Brief needs its own RabbitMQ user and
# vhost, and its own Garage key and bucket:
#   garage key create brief-prod
#   garage bucket create brief-prod
#   garage bucket allow --read --write --owner brief-prod --key <key id>
REDIS_URL=redis://:CHANGE_ME@redis-prod:6379
BETTER_AUTH_REDIS_KEY_PREFIX=brief:auth:

AMQP_URL=amqp://brief:CHANGE_ME@rabbitmq-prod:5672/brief
PROVIDER_FETCH_QUEUE=brief-provider-fetch
CATEGORY_QUEUE=brief-category
MESSAGE_JOB_QUEUE=brief-message-job
WORKER_ID=1

S3_ENDPOINT=http://garage-prod:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=brief-prod

# Set only if the shared networks are named differently on the host.
# REDIS_NETWORK=redis-network
# RABBITMQ_NETWORK=rabbitmq-network
# GARAGE_NETWORK=garage-network
# MONITORING_SHARED_NETWORK=monitoring-shared

# --- Web -------------------------------------------------------------------
# The public origin, without a trailing slash. WEB_HOST_PORT is published on
# loopback for the reverse proxy in front.
WEB_HOST_PORT=3020
SITE_URL=https://brief.example.com
BETTER_AUTH_URL=https://brief.example.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Extra hostnames the server answers to, comma-separated. SITE_URL's host is
# already allowed; anything else gets a 403 from `vite preview`. The container
# name is here because Prometheus scrapes `http://brief-web-prod:3000/metrics`
# over the monitoring network, and that Host is not SITE_URL's — drop it and the
# scrape fails with a 403 that looks, from Grafana, like the app being down.
WEB_ALLOWED_HOSTS=brief-web-prod
ADMIN_USER_IDS=

# --- Third parties ---------------------------------------------------------
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Voicing the brief. Commented out rather than left empty: compose passes an
# empty line through as "" and the schema rejects that where it would have
# applied its default.
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=onyx
# TTS_INSTRUCTIONS=
# TTS_SPEED=1.1

# --- Telegram --------------------------------------------------------------
# From @BotFather. The username has no leading `@`. Register the webhook once:
#   make telegram-webhook ENV_FILE=.env.docker TELEGRAM_WEBHOOK_URL=https://...
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

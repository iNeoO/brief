PG_DB=monorepo_template
PG_USER=monorepo_template
PG_PASSWORD=monorepo_template_password
PG_URL=postgresql://monorepo_template:monorepo_template_password@localhost/monorepo_template

FRONTEND_URL=http://localhost:5173
OPENAI_API_KEY=

# Storage. Garage, run by docker-compose locally on offset ports so the stack
# can sit next to another project's Garage.
S3_ENDPOINT=localhost
S3_PORT=3910
S3_REGION=garage
S3_USE_SSL=false
# Dev credentials: `pnpm garage:init` imports these into Garage. The key id
# must be "GK" followed by 24 hex characters, the secret 64 hex characters.
#   printf 'GK%s\n' "$(openssl rand -hex 12)" && openssl rand -hex 32
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=brief-dev

# Garage's own secrets — generate each with `openssl rand -hex 32`.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Message broker and workers.
AMQP_URL=amqp://localhost:5672
PROVIDER_FETCH_QUEUE=provider-fetch
CATEGORY_QUEUE=category
MESSAGE_JOB_QUEUE=message-job
WORKER_ID=1

# Optional — voicing the brief. Defaults to gpt-4o-mini-tts and the onyx voice.
TTS_MODEL=
TTS_VOICE=
# Delivery: leave empty to use the newsreader instructions for the brief's language.
TTS_INSTRUCTIONS=
TTS_SPEED=

PG_DB=monorepo_template
PG_USER=monorepo_template
PG_PASSWORD=monorepo_template_password
# The port matches docker-compose, which offsets it to keep out of the way of
# another project's Postgres on 5432. Leaving it out here is what makes the app
# connect to whatever else is listening on the default port.
PG_URL=postgresql://monorepo_template:monorepo_template_password@localhost:5433/monorepo_template

FRONTEND_URL=http://localhost:5173
OPENAI_API_KEY=

# Storage. Garage, run by docker-compose locally on an offset port so the stack
# can sit next to another project's Garage. S3_ENDPOINT is the full S3 API URL.
S3_ENDPOINT=http://localhost:3910
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
# Dev credentials: `pnpm garage:init` imports these into Garage. The key id
# must be "GK" followed by 24 hex characters, the secret 64 hex characters.
#   printf 'GK%s\n' "$(openssl rand -hex 12)" && openssl rand -hex 32
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=brief-dev

# Garage's own secrets — generate each with `openssl rand -hex 32`.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

BETTER_AUTH_URL=http://localhost:3000
# The public origin of the site, without a trailing slash. Canonical URLs, the
# sitemap and the social-card metadata are absolute, and taking the host off the
# incoming request would hand a crawler whatever the proxy in front says.
SITE_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
REDIS_URL=redis://localhost:6379
BETTER_AUTH_REDIS_KEY_PREFIX=brief:auth:
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where the contact form lands. Commented out rather than left empty: an empty
# value reaches the schema as "" and is rejected, where an absent one falls back
# to the address the site displays (contact@dailybriefs.fr). Set it to the inbox
# someone actually reads.
# CONTACT_INBOX_EMAIL=
# Comma-separated user ids granted admin whatever their role column says. This
# is how the first admin gets in; the rest are promoted by an existing admin.
ADMIN_USER_IDS=

# Message broker and workers. RabbitMQ runs in docker-compose on its default
# ports; in dev it keeps its guest/guest account, so the URL carries no
# credentials. Management UI: http://localhost:15672
AMQP_URL=amqp://localhost:5672
# One queue per step of the daily pipeline. Each one gets a matching
# `<queue>.dlq` dead-letter queue, declared by the app at connection time.
PROVIDER_FETCH_QUEUE=provider-fetch
CATEGORY_QUEUE=category
MESSAGE_JOB_QUEUE=message-job
# Identifies the worker in its logs. Give each replica its own value.
WORKER_ID=1

# Optional — voicing the brief. Defaults to gpt-4o-mini-tts and the onyx voice.
TTS_MODEL=
TTS_VOICE=
# Delivery: leave empty to use the newsreader instructions and the reading rate
# that go with the brief's language (French is read at 1.2, English at 1.1).
TTS_INSTRUCTIONS=
TTS_SPEED=

# Telegram pairing. Pairing is the reader starting the conversation: they open the
# bot through a t.me deep link and press Start, our webhook receives the resulting
# `/start <code>`, and the chat id it carries is the proof. The consent itself is
# given on our page — pressing Start proves the account, not the agreement.
#
# From @BotFather, on /newbot. Grants the right to write to every chat that has
# started the bot, so treat it as a password.
TELEGRAM_BOT_TOKEN=
# The bot's username without the leading `@`, 5-32 characters. This is what the
# t.me deep link addresses; a wrong value produces a link to nowhere.
TELEGRAM_BOT_USERNAME=
# Our own value, sent back by Telegram as X-Telegram-Bot-Api-Secret-Token on every
# webhook call. Given to setWebhook once — see docs/telegram-pairing-testing.md.
# openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
